+import { describe, expect, test } from "vitest";
+import type { Principal } from "../identity/identity";
+import { type HoldReader, type HoldView, readOwnHold } from "./hold-access";
+
+const hold: HoldView = {
+  id: "hold-1",
+  buyerKey: "session-owner",
+  seatIds: ["A-1", "A-2"],
+  expiresAt: new Date("2026-11-01T12:00:00Z"),
+};
+
+const holds: HoldReader = {
+  findById: async (holdId) => (holdId === hold.id ? hold : undefined),
+};
+
+const guest = (sessionId: string): Principal => ({ kind: "guest", sessionId });
+
+describe("readOwnHold", () => {
+  test("returns the hold to the guest who owns it", async () => {
+    expect(await readOwnHold(holds, guest("session-owner"), "hold-1")).toEqual(hold);
+  });
+
+  test("another guest's hold is reported as missing", async () => {
+    expect(await readOwnHold(holds, guest("session-stranger"), "hold-1")).toBeUndefined();
+  });
+
+  test("an unknown hold id yields undefined", async () => {
+    expect(await readOwnHold(holds, guest("session-owner"), "hold-404")).toBeUndefined();
+  });
+});
