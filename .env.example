# Copy to `.env` and fill in. Never commit real values.

# Neon PostgreSQL: pooled connection string (used at runtime by the Prisma Neon adapter)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/ticketarena?sslmode=require"

# Upstash Redis: REST credentials for the waiting-room queue
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# HMAC key for the ta_session cookie (ADR 0012); at least 32 bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET="replace-me-with-at-least-32-bytes-of-randomness"

# NATS JetStream for the outbox relay and consumers (ADR 0004); matches `pnpm infra:up`
NATS_URL="nats://localhost:4222"

# Ralph harness / sandbox (only needed when running ./scripts/sandbox.sh)
ANTHROPIC_API_KEY=""
