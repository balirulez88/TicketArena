// Domain models arrive slice by slice under TDD. Payment tables are still to come.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("public")
}

/// Transactional Outbox.
/// Business writes and their integration events are committed in the SAME Postgres
/// transaction, which removes the dual-write problem (DB commit succeeds, broker publish
/// fails, or vice versa). A separate relay process polls PENDING rows and publishes them to
/// the broker, giving at-least-once delivery; consumers must therefore be idempotent and
/// deduplicate on `id`.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  /// Aggregate type + id identify the stream; the relay preserves order per aggregate.
  aggregateType String
  aggregateId   String
  /// Broker subject/topic name, e.g. "booking.confirmed".
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  // Supports the relay's hot query: "oldest PENDING events first".
  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
  @@schema("public")
}

enum SeatStatus {
  AVAILABLE
  HELD
  IN_CHECKOUT
  SOLD

  @@schema("public")
}

model Venue {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  sections Section[]
  events   Event[]

  @@map("venues")
  @@schema("public")
}

/// A priced area of a venue. Prices are integer minor units (cents) so money never touches
/// floating point; the currency is stored beside them for the day a second one appears.
model Section {
  id         String @id @default(uuid()) @db.Uuid
  venueId    String @db.Uuid
  venue      Venue  @relation(fields: [venueId], references: [id])
  name       String
  priceMinor Int
  currency   String @default("EUR")
  rows       Row[]

  @@unique([venueId, name])
  @@map("sections")
  @@schema("public")
}

model Row {
  id        String  @id @default(uuid()) @db.Uuid
  sectionId String  @db.Uuid
  section   Section @relation(fields: [sectionId], references: [id])
  label     String
  seats     Seat[]

  @@unique([sectionId, label])
  @@map("rows")
  @@schema("public")
}

model Event {
  id            String   @id @default(uuid()) @db.Uuid
  venueId       String   @db.Uuid
  venue         Venue    @relation(fields: [venueId], references: [id])
  name          String   @unique
  onSaleAt      DateTime @db.Timestamptz(3)
  queueOpensAt  DateTime @db.Timestamptz(3)
  queueClosesAt DateTime @db.Timestamptz(3)
  /// The event the admin dashboard races and resets.
  demo          Boolean  @default(false)
  seats         Seat[]
  holds         Hold[]

  @@map("events")
  @@schema("public")
}

/// Seat inventory is per event: the same physical row has independent availability for each
/// event. Postgres is the sole authority for seat state (ADR 0005); Redis never decides it.
model Seat {
  id            String     @id @default(uuid()) @db.Uuid
  eventId       String     @db.Uuid
  event         Event      @relation(fields: [eventId], references: [id])
  rowId         String     @db.Uuid
  row           Row        @relation(fields: [rowId], references: [id])
  number        Int
  status        SeatStatus @default(AVAILABLE)
  holdId        String?    @db.Uuid
  hold          Hold?      @relation(fields: [holdId], references: [id])
  /// Buyer who holds or has bought the seat, backing the per-event ticket limit.
  claimBuyerKey String?

  @@unique([eventId, rowId, number])
  @@index([eventId, status])
  @@map("seats")
  @@schema("public")
}

enum HoldStatus {
  HELD
  ORDERED
  RELEASED
  EXPIRED

  @@schema("public")
}

/// A buyer's time-boxed claim on seats. The expiry is stored, never swept into existence by a
/// timer: a HELD seat whose hold has expired is treated as free at decision time (lazy expiry).
/// `correlationId` is minted with the hold and carried by every event of the booking.
model Hold {
  id            String     @id @default(uuid()) @db.Uuid
  eventId       String     @db.Uuid
  event         Event      @relation(fields: [eventId], references: [id])
  sessionId     String
  userId        String?
  buyerKey      String
  status        HoldStatus @default(HELD)
  holdExpiresAt DateTime   @db.Timestamptz(3)
  correlationId String     @db.Uuid
  seats         Seat[]
  order         Order?

  @@index([eventId, buyerKey])
  @@map("holds")
  @@schema("public")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED

  @@schema("public")
}

/// A buyer's checkout of one hold. `paymentDeadline` is fixed at placement and never extended.
/// `(sessionId, idempotencyKey)` makes `placeOrder` retry-safe (ADR 0007); `requestHash`
/// detects a key reused for a different request. `holdId` is unique: one order per hold.
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  holdId          String      @unique @db.Uuid
  hold            Hold        @relation(fields: [holdId], references: [id])
  sessionId       String
  buyerKey        String
  contactEmail    String
  contactPhone    String?
  totalMinor      Int
  currency        String
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentDeadline DateTime    @db.Timestamptz(3)
  idempotencyKey  String
  requestHash     String
  correlationId   String      @db.Uuid
  createdAt       DateTime    @db.Timestamptz(3)
  lines           OrderLine[]

  @@unique([sessionId, idempotencyKey])
  @@map("orders")
  @@schema("public")
}

/// Price and currency are copied at placement so later catalog changes never alter an order.
model OrderLine {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @db.Uuid
  order      Order  @relation(fields: [orderId], references: [id])
  seatId     String @db.Uuid
  priceMinor Int
  currency   String

  @@unique([orderId, seatId])
  @@map("order_lines")
  @@schema("public")
}
