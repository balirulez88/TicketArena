+import { buyerKey, type Principal } from "../identity/identity";
+
+export interface HoldView {
+  readonly id: string;
+  readonly buyerKey: string;
+  readonly seatIds: readonly string[];
+  readonly expiresAt: Date;
+}
+
+export interface HoldReader {
+  findById(holdId: string): Promise<HoldView | undefined>;
+}
+
+/**
+ * A hold reveals which seats a buyer is about to pay for, so a hold that is not the caller's is
+ * indistinguishable from one that does not exist.
+ */
+export async function readOwnHold(
+  holds: HoldReader,
+  principal: Principal,
+  holdId: string,
+): Promise<HoldView | undefined> {
+  const hold = await holds.findById(holdId);
+  if (!hold) {
+    return undefined;
+  }
+  if (principal.kind === "user" || hold.buyerKey === buyerKey(principal)) {
+    return hold;
+  }
+  return undefined;
+}
