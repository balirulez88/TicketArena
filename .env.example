# Copy to `.env` and fill in. Never commit real values.

# Neon PostgreSQL: pooled connection string (used at runtime by the Prisma Neon adapter)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/ticketarena?sslmode=require"
# Prisma driver for the web app: "neon" (default) for Neon, "pg" for a local Postgres
DATABASE_DRIVER="neon"

# Upstash Redis: REST credentials for the booking metrics counters (https; plain http only on
# localhost, e.g. the compose redis-http service)
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# Redis for the waiting-room queue (node-redis); matches `pnpm infra:up`, `rediss://` when hosted
REDIS_URL="redis://localhost:6379"
# Optional bounds on every Redis call, in ms (defaults 2000 and 1000): a Redis outage fails calls
# within them instead of hanging requests (also read by apps/worker)
# REDIS_CONNECT_TIMEOUT_MS="2000"
# REDIS_COMMAND_TIMEOUT_MS="1000"

# HMAC key for the ta_session cookie (ADR 0012); at least 32 bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET="replace-me-with-at-least-32-bytes-of-randomness"

# HS256 key of the waiting-room admission token (ADR 0008); at least 32 bytes, separate from
# SESSION_SECRET, e.g. `openssl rand -hex 32`
ADMISSION_SECRET="replace-me-with-another-32-bytes-of-randomness"

# Operator password for /admin (ADR 0012); at least 12 characters. The admin cookie it unlocks
# is signed with SESSION_SECRET.
ADMIN_PASSWORD="replace-me-admin-password"

# NATS JetStream for the outbox relay and consumers (ADR 0004); matches `pnpm infra:up`
NATS_URL="nats://localhost:4222"

# Worker admission ticker (ADR 0008): admissions per second per event (also the burst), and the
# cap on active shoppers per event. Optional; these are the defaults.
ADMIT_RATE_PER_SECOND="10"
MAX_ACTIVE="100"

# Worker health port (apps/worker `/health`); optional, defaults to 8080 (also set in its fly.toml)
# PORT="8080"

# ---------------------------------------------------------------------------------------------
# Production (ADR 0013; setup in docs/operations/deployment.md). Never read from this file:
# each value lives in the platform named, and the app's boundary validates it at start-up.
#
# Vercel project (web), Production environment:
#   DATABASE_URL          Neon POOLED endpoint (host `ep-...-pooler.<region>.aws.neon.tech`);
#                         parseServerEnv refuses a direct Neon host
#   DATABASE_DRIVER       leave unset: "neon" (the Neon serverless adapter) is the default
#   UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN   Upstash REST endpoint and token (https)
#   REDIS_URL             Upstash's TLS Redis endpoint, `rediss://default:<token>@<host>:6379`
#   SESSION_SECRET, ADMISSION_SECRET, ADMIN_PASSWORD   as above, fresh production values
#
# Fly.io app `ticketarena-worker` (`fly secrets set`); NATS_URL, PORT, ADMIT_RATE_PER_SECOND
# and MAX_ACTIVE are plain [env] in infra/fly/worker/fly.toml:
#   DATABASE_URL          Neon DIRECT endpoint (no `-pooler`): a long-running TCP pool
#   REDIS_URL             the same Upstash `rediss://` URL as the web app
#
# GitHub repository secrets (.github/workflows/deploy.yml; a target is skipped while its are unset):
#   DATABASE_URL_UNPOOLED Neon DIRECT endpoint, used only by `prisma migrate deploy`
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID   Vercel CLI deploy of apps/web
#   FLY_API_TOKEN         deploy token of the `ticketarena-worker` Fly app
# ---------------------------------------------------------------------------------------------

# Ralph harness / sandbox (only needed when running ./scripts/sandbox.sh)
ANTHROPIC_API_KEY=""
