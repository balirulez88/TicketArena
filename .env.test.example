# Copy to `.env.test` (git-ignored) to run integration tests against `pnpm infra:up`.
# CI and the Ralph sandbox set these variables themselves.
# The database URL must allow CREATE DATABASE: tests clone a migrated template per file.
TEST_DATABASE_URL="postgresql://ticketarena:ticketarena@localhost:55432/postgres"
TEST_REDIS_URL="redis://localhost:6379"
TEST_NATS_URL="nats://localhost:4222"
# Optional: Upstash-compatible REST endpoint for the Upstash adapter contract suites. Defaults to
# the `redis-http` service in docker-compose.yml, so these lines only document the values.
TEST_UPSTASH_REDIS_REST_URL="http://localhost:8079"
TEST_UPSTASH_REDIS_REST_TOKEN="ticketarena"
